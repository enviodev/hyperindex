{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/start-postgres.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/start-clickhouse.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in */packages/cli/*.rs) cd \"${f%%/packages/cli/*}/packages/cli\" && cargo fmt 2>&1 || true ;; esac; }",
            "timeout": 30,
            "statusMessage": "Running cargo fmt..."
          },
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in *.res|*.resi) cd \"$CLAUDE_PROJECT_DIR\" && pnpx rescript@12.3.1 format \"$f\" || true ;; esac; }",
            "timeout": 60,
            "statusMessage": "Running rescript format..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-push.sh",
            "timeout": 600,
            "statusMessage": "Checking before push..."
          }
        ]
      }
    ]
  }
}
