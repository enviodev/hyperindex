type accountState = enum {uninitialized, initialized, frozen}
type authorityType = enum {mintTokens, freezeAccount, accountOwner, closeAccount}
unusable instruction batch: instruction 'batch'.data.item.instructionData.prefix: Borsh needs u32 here, got u8
unusable instruction uiAmountToAmount: instruction 'uiAmountToAmount'.uiAmount: a bare stringTypeNode carries no length; Borsh needs it wrapped in a sizePrefixTypeNode with a u32 prefix
