// `envio dev` type-checks the mappings with the project's `graph build`. For
// a manifest naming its files in another case than the repo has them
// (CryptoPunks' `./abis/WrappedPunks.json` for `abis/wrappedpunks.json`),
// graph-cli on Linux can't read them, and the dev run failed on the type
// check that codegen had already got past. It gets the manifest spelled the
// repo's way too.
let manifest = `
specVersion: 0.0.5
schema:
  file: ./schema.graphql
dataSources:
  - kind: ethereum/contract
    name: WrappedPunks
    network: mainnet
    source:
      address: "0x1111111111111111111111111111111111111111"
      abi: WrappedPunks
      startBlock: 0
    mapping:
      kind: ethereum/events
      apiVersion: 0.0.7
      language: wasm/assemblyscript
      entities:
        - Probe
      abis:
        - name: WrappedPunks
          file: ./abis/WrappedPunks.json
      eventHandlers:
        - event: Created(uint256)
          handler: handleCreated
      file: ./src/wrapped.ts
`

// graph-cli reads every file its manifest names, in codegen and in build.
let graphCliCommand = `
import { existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
import path from "node:path";

export default class Command {
  static async run(argv) {
    const manifest = argv.find((arg) => arg.endsWith(".yaml"));
    for (const [, file] of readFileSync(manifest, "utf8").matchAll(/file: (\\S+)/g)) {
      if (!existsSync(path.join(path.dirname(manifest), file))) throw new Error("graph-cli: no " + file);
    }
    const outputDir = argv[argv.indexOf("--output-dir") + 1];
    mkdirSync(outputDir, { recursive: true });
    writeFileSync(path.join(outputDir, "by.ts"), "export const by = \\"graph-cli\\";\\n");
  }
}
`

let _ = InternalTestIndexer.fromSubgraph(
  ~manifest="",
  ~schema="",
  ~fromProjectFiles=true,
  ~isDev=true,
  ~mappings=Dict.fromArray([
    ("subgraph.yaml", manifest),
    (
      "schema.graphql",
      `
type Probe @entity {
  id: ID!
  value: String!
}
`,
    ),
    (
      "abis/wrappedpunks.json",
      `[{"type":"event","name":"Created","anonymous":false,"inputs":[{"name":"amount","type":"uint256","indexed":false}]}]`,
    ),
    (
      "node_modules/@graphprotocol/graph-cli/package.json",
      `{"name":"@graphprotocol/graph-cli","type":"module"}`,
    ),
    ("node_modules/@graphprotocol/graph-cli/dist/commands/codegen.js", graphCliCommand),
    ("node_modules/@graphprotocol/graph-cli/dist/commands/build.js", graphCliCommand),
    (
      "src/wrapped.ts",
      `
import { Entity, store } from "@graphprotocol/graph-ts";
import { by } from "../generated/by";

export function handleCreated(event: any): void {
  let probe = new Entity();
  probe.setString("value", "generated by " + by);
  store.set("Probe", "case", probe);
}
`,
    ),
  ]),
  ~test=`
import { describe, it } from "vitest";
import { createTestIndexer } from "envio";

describe("envio dev on a manifest naming its files in another case", () => {
  it("type-checks the files the repo has", async (t) => {
    const indexer = createTestIndexer();

    await indexer.process({
      chains: { 1: { simulate: [{ contract: "WrappedPunks", event: "Created", params: { amount: 1n } }] } },
    });

    t.expect(await indexer.Probe.getAll()).toEqual([{ id: "case", value: "generated by graph-cli" }]);
  });
});
`,
)
