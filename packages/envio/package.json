{
  "name": "envio",
  "version": "0.0.1-dev",
  "private": true,
  "type": "module",
  "description": "A latency and sync speed optimized, developer friendly blockchain data indexer.",
  "bin": "./bin.mjs",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./sidecar": {
      "types": "./sidecar.d.ts",
      "default": "./sidecar.js"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enviodev/hyperindex.git"
  },
  "scripts": {
    "build": "rescript && tsc -p tsconfig.sidecar.json",
    "build:sidecar": "tsc -p tsconfig.sidecar.json",
    "watch": "rescript watch"
  },
  "author": "envio contributors <about@envio.dev>",
  "license": "SEE LICENSE IN licenses/README.md",
  "bugs": {
    "url": "https://github.com/enviodev/hyperindex/issues"
  },
  "homepage": "https://envio.dev",
  "keywords": [
    "blockchain",
    "indexer",
    "ethereum",
    "evm",
    "fuel",
    "solana",
    "data",
    "dapp"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "files": [
    "bin.mjs",
    "evm.schema.json",
    "fuel.schema.json",
    "svm.schema.json",
    "rescript.json",
    "index.d.ts",
    "index.js",
    "sidecar.d.ts",
    "sidecar.js",
    "src",
    "licenses"
  ],
  "dependencies": {
    "@elastic/ecs-pino-format": "1.4.0",
    "@rescript/runtime": "12.2.0",
    "bignumber.js": "9.3.1",
    "dotenv": "16.4.5",
    "eventsource": "4.1.0",
    "express": "4.19.2",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "postgres": "3.4.8",
    "rescript-schema": "9.5.1",
    "viem": "2.54.0"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "24.12.2",
    "rescript": "12.2.0",
    "typescript": "6.0.3",
    "vitest": "4.1.0"
  }
}
